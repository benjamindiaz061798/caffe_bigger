# Copiar a .env.local. La integración usa credenciales públicas de prueba.
WEBPAY_ENV=integration
APP_URL=http://localhost:3000
# Almacenamiento local de pedidos. En producción debe ser un volumen persistente,
# con una sola instancia de servidor o migrarse a una base de datos transaccional.
# ORDER_DATA_DIR=C:/ruta/persistente/bigger-orders
# Solo para producción después de validar tu integración con Transbank:
# WEBPAY_ENV=production
# WEBPAY_COMMERCE_CODE=
# WEBPAY_API_KEY=
# APP_URL=https://tu-dominio.cl
